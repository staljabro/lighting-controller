<Window x:Class="LightingController.App.PresetNameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rename Preset" Width="440" Height="210" ResizeMode="NoResize" Background="#1E2226" Foreground="White" WindowStartupLocation="CenterOwner">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="PromptText" FontSize="17" FontWeight="SemiBold" Margin="4"/><TextBox x:Name="NameText" Grid.Row="1" Margin="4,14" Padding="12" FontSize="18"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CANCEL" IsCancel="True" Margin="5" Padding="18,10"/><Button Content="RENAME" IsDefault="True" Click="Rename_Click" Margin="5" Padding="18,10" Background="#176B87" Foreground="White"/></StackPanel></Grid>
</Window>
