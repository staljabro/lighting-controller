<Window x:Class="LightingController.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lighting Controller" Height="820" Width="1440" MinHeight="640" MinWidth="1024"
        Background="#15181B" Foreground="#F2F2F2" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#30363B"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B555C"/><Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E2226"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3C444A"/><Setter Property="RowBackground" Value="#20252A"/>
            <Setter Property="AlternatingRowBackground" Value="#252B30"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#343B40"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#22272B" BorderBrush="#3C444A" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,4">
                <TextBlock Text="LIGHTING CONTROLLER" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,28,0"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="PATCH"/><Button Content="FIXTURES"/>
                    <Button Content="PROGRAMMER" Background="#176B87" BorderBrush="#28A9D2"/>
                    <Button Content="CUE LISTS"/><Button Content="PLAYBACK"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="OUTPUT OFF" Foreground="#FFB34D" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#1E2226" BorderBrush="#3C444A" BorderThickness="1" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="FIXTURE SELECTION" FontWeight="Bold" Margin="6,4,6,12"/>
                    <UniformGrid Columns="2" Rows="6">
                        <Button Content="LED BARS"/><Button Content="BEAMS" Background="#176B87"/><Button Content="WASHES"/><Button Content="ALL"/>
                        <Button Content="BEAM 1" Background="#176B87"/><Button Content="BEAM 2"/><Button Content="BEAM 3"/><Button Content="BEAM 4"/>
                    </UniformGrid>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="10,0">
                <Grid.RowDefinitions><RowDefinition Height="250"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#1E2226" BorderBrush="#3C444A" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="PROGRAMMER — BEAM 1" FontWeight="Bold" Margin="6,4,6,10"/>
                        <UniformGrid Columns="5" Rows="3">
                            <Button Content="DIMMER 0%"/><Button Content="DIMMER 25%"/><Button Content="DIMMER 50%"/><Button Content="DIMMER 75%"/><Button Content="DIMMER FULL"/>
                            <Button Content="WHITE" Background="#D8D8D8" Foreground="#151515"/><Button Content="RED" Background="#932C32"/>
                            <Button Content="GREEN" Background="#297448"/><Button Content="BLUE" Background="#28599B"/><Button Content="MAGENTA" Background="#823C87"/>
                            <Button Content="HOME"/><Button Content="CENTRE"/><Button Content="HIGH"/><Button Content="LOW"/><Button Content="CROSS"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="#1E2226" BorderBrush="#3C444A" BorderThickness="1" Margin="0,10,0,0" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="CUE STACK — MAIN" FontWeight="Bold" Margin="6,4,6,10"/>
                        <DataGrid ItemsSource="{Binding Cues}" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cue" Binding="{Binding Number}" Width="70"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Fade" Binding="{Binding Fade}" Width="90"/>
                                <DataGridTextColumn Header="Delay" Binding="{Binding Delay}" Width="90"/>
                                <DataGridTextColumn Header="Follow" Binding="{Binding Follow}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
            <Border Grid.Column="2" Background="#1E2226" BorderBrush="#3C444A" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="PAN / TILT" FontWeight="Bold" Margin="6,4,6,10"/>
                    <Border Grid.Row="1" Margin="8" Background="#121518" BorderBrush="#4B555C" BorderThickness="1">
                        <Grid><Ellipse Width="24" Height="24" Fill="#28A9D2" Stroke="White" StrokeThickness="2"/></Grid>
                    </Border>
                    <UniformGrid Grid.Row="2" Columns="2"><Button Content="CLEAR"/><Button Content="STORE" Background="#176B87"/></UniformGrid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#22272B" BorderBrush="#3C444A" BorderThickness="0,1,0,0">
            <UniformGrid Columns="8" Margin="8">
                <Button Content="BACK"/><Button Content="PAUSE"/><Button Content="GO" Background="#23864C" BorderBrush="#39B86A"/>
                <Button Content="RELEASE"/><Button Content="RECORD" Background="#8B312F"/><Button Content="UPDATE" Background="#7A621E"/>
                <Button Content="EDIT"/><Button Content="DELETE"/>
            </UniformGrid>
        </Border>
    </Grid>
</Window>

