<Window x:Class="LightingController.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LightingController.App" Title="Lighting Controller" Height="900" Width="1480" MinHeight="740" MinWidth="1100" Background="#15181B" Foreground="#F2F2F2" WindowStartupLocation="CenterScreen" PreviewTextInput="Window_PreviewTextInput" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#292D30"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4B555C"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="3"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="42"/></Style>
  <Style TargetType="DataGrid" BasedOn="{StaticResource DarkDataGridStyle}"/>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <Border Background="#22272B" BorderBrush="#3C444A" BorderThickness="0,0,0,1">
   <Grid Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><TextBlock Text="LIGHTING CONTROLLER" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,24,0"/><Button x:Name="PatchNavigationButton" Content="PATCH" Tag="Patch" Click="Navigation_Click"/><Button x:Name="ProgrammerNavigationButton" Content="PROGRAMMER" Tag="Programmer" Click="Navigation_Click"/><Button x:Name="CuesNavigationButton" Content="CUE LISTS" Tag="Cues" Click="Navigation_Click"/><Button x:Name="SettingsNavigationButton" Content="SETTINGS" Click="OpenSettings_Click"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="254,0,0,0"><Button x:Name="FixtureDrawerButton" Content="HIDE FIXTURES" Click="ToggleFixtureDrawer_Click"/><Button x:Name="ControlsDrawerButton" Content="HIDE CONTROLS" Click="ToggleControlsDrawer_Click"/><Button x:Name="PanTiltDrawerButton" Content="HIDE PAN / TILT" Click="TogglePanTiltDrawer_Click"/></StackPanel>
<StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OnlineButton" Content="LIVE OUTPUT: ONLINE" Click="OnlineToggle_Click" Background="#23864C"/><Button x:Name="BlackoutButton" Content="BLACKOUT" Click="Blackout_Click"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="10">
   <Grid x:Name="PatchWorkspace">
    <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#1E2226" BorderBrush="#3C444A" BorderThickness="1" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" Text="FIXTURE LIBRARY - DRAG INTO PATCH" FontWeight="Bold" Margin="6,4,6,8"/><TextBox x:Name="LibrarySearchText" DockPanel.Dock="Top" Margin="4" Padding="7" TextChanged="LibrarySearchText_TextChanged"/><StackPanel DockPanel.Dock="Bottom"><StackPanel Orientation="Horizontal"><Button Content="ADD PROFILE" Click="ImportFixture_Click"/><Button Content="NEW FIXTURE" Click="OpenFixtureEditor_Click"/><Button Content="EDIT PROFILE" Click="EditFixtureProfile_Click"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="SAVE SHOW" Click="SaveShow_Click"/><Button Content="LOAD SHOW" Click="LoadShow_Click"/></StackPanel></StackPanel><ListBox x:Name="FixtureLibraryList" ItemsSource="{Binding VisibleLibrary}" PreviewMouseMove="FixtureLibraryList_PreviewMouseMove" Background="#20252A" Foreground="White" BorderBrush="#4B555C"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,6"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Details}" Foreground="#B8C1C7" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
    <Border Grid.Column="1" Margin="10,0,0,0" Background="#1E2226" BorderBrush="#3C444A" BorderThickness="1" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" Text="FIXTURE PATCH" FontWeight="Bold" Margin="6,4,6,8"/><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="RENAME" Click="RenameFixture_Click"/><Button Content="REMOVE" Click="RemoveFixture_Click"/><Button Content="OUTPUT PATCH" Click="OpenOutputPatch_Click"/><Button Content="DMX ALLOCATION / LIVE" Click="OpenDmxMonitor_Click"/><Button Content="FIXTURE OUTPUT DETAILS" Click="OpenFixtureDetails_Click"/><Button Content="SEND TEST" Click="SendOutputTest_Click"/></StackPanel><DataGrid x:Name="FixtureGrid" ItemsSource="{Binding Fixtures}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionChanged="FixtureGrid_SelectionChanged" MouseDoubleClick="OpenFixtureDetails_Click" AllowDrop="True" DragOver="FixtureGrid_DragOver" Drop="FixtureGrid_Drop"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/><DataGridTextColumn Header="Fixture type" Binding="{Binding FixtureType}" Width="180"/><DataGridTextColumn Header="Fixture name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Universe" Binding="{Binding Universe}" Width="90"/><DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="90"/></DataGrid.Columns></DataGrid></DockPanel></Border>
    <StackPanel Visibility="Collapsed"><ComboBox x:Name="OutputProtocolCombo" SelectionChanged="OutputProtocolCombo_SelectionChanged"/><TextBox x:Name="OutputDestinationText" Text="127.0.0.1"/><TextBox x:Name="OutputUniverseText" Text="1"/></StackPanel>
   </Grid>
   <Grid x:Name="ProgrammerWorkspace" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="FixtureDrawerColumn" Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ControlsDrawerColumn" Width="210"/><ColumnDefinition x:Name="PanTiltDrawerColumn" Width="300"/></Grid.ColumnDefinitions>
<Border x:Name="FixtureDrawer" Background="#1E2226" BorderBrush="#3C444A" BorderThickness="1" Padding="5"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="FIXTURES" FontWeight="Bold" Margin="3"/><ListBox x:Name="SelectionPresetList" Visibility="Collapsed" ItemsSource="{Binding SelectionPresets}" SelectionChanged="SelectionPresetList_SelectionChanged"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ProgrammerFixtures}"><ItemsControl.ItemTemplate><DataTemplate><Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Visibility="{Binding PartsVisibility}" Margin="0"><Expander.Header><Button Tag="{Binding}" Click="ProgrammerFixtureButton_Click" HorizontalContentAlignment="Left" MinHeight="24" MinWidth="0" Margin="0" Padding="4,2" FontSize="13"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsHighlighted}" Value="True"><Setter Property="Background" Value="#176B87"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="{Binding DisplayName}"/></Button></Expander.Header><ItemsControl ItemsSource="{Binding Parts}" Margin="18,0,0,1"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="ProgrammerPartButton_Click" HorizontalContentAlignment="Left" MinHeight="22" MinWidth="0" Margin="0" Padding="4,1" FontSize="12"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#176B87"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="{Binding DisplayName}"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
    <Grid Grid.Column="1" Margin="8,0"><Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="150"/><RowDefinition Height="*"/><RowDefinition Height="270"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#171B1E" BorderBrush="#3C444A" BorderThickness="1" Padding="7"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBlock Text="FIXTURE GROUP POOL - ORDERED SELECTIONS" FontWeight="Bold" VerticalAlignment="Center" Margin="6"/></StackPanel><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding SelectionPresets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="112" Height="88" Margin="3" Tag="{Binding}" Click="SelectionPresetButton_Click"><Grid><Border BorderBrush="#00D7D7" BorderThickness="3" CornerRadius="4" Background="#1B1D1F"/><TextBlock Text="{Binding Slot}" Foreground="#8E969C" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4"/><TextBlock Text="ORDER" Foreground="#FFCB36" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"/><TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom" Margin="6,25,6,8"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
     <Border Grid.Row="1" Margin="0,8,0,0" Background="#18131F" BorderBrush="#633D78" BorderThickness="1" Padding="7"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBlock Text="EFFECT POOL" FontWeight="Bold" VerticalAlignment="Center" Margin="6"/></StackPanel><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="EffectsView" ItemsSource="{Binding Effects}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="118" Height="88" Margin="3" Tag="{Binding}" Click="EffectPresetButton_Click" PreviewMouseRightButtonUp="EffectPresetButton_RightClick"><Grid><Border BorderBrush="#A45BC6" BorderThickness="3" CornerRadius="4" Background="#211927"/><TextBlock Text="{Binding Slot}" Foreground="#9B8DA3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4"/><TextBlock Text="{Binding ScopeShort}" Foreground="#FFCB36" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7,4"/><TextBlock Text="{Binding LineSummary}" Foreground="#C8B7D0" FontSize="10" TextAlignment="Center" VerticalAlignment="Center" Margin="4"/><TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom" Margin="5,4,5,7"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
     <Border Grid.Row="2" Background="#121518" BorderBrush="#3C444A" BorderThickness="1" Padding="7"><DockPanel><TextBlock x:Name="PresetPoolTitle" DockPanel.Dock="Top" Text="INTENSITY PRESET POOL" FontWeight="Bold" Margin="6"/><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ColourPresetList" ItemsSource="{Binding VisiblePresets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="105" Height="92" Margin="3" Padding="0" MinHeight="0" Tag="{Binding}" Click="ColourPresetButton_Click" PreviewMouseRightButtonDown="PresetButton_RightDown" PreviewMouseRightButtonUp="PresetButton_RightUp"><Grid><Border BorderBrush="{Binding BorderColour}" BorderThickness="3" CornerRadius="4" Background="#1B1D1F"/><TextBlock Text="{Binding Slot}" Foreground="#8E969C" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4"/><TextBlock Text="{Binding ScopeShort}" Visibility="{Binding FilledVisibility}" Foreground="#FFCB36" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4"/><Border Width="23" Height="23" Visibility="{Binding FilledVisibility}" Background="{Binding Swatch}" BorderBrush="#D8D8D8" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"/><TextBlock Text="{Binding Name}" Visibility="{Binding FilledVisibility}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom" Margin="6,32,6,8"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
     <Border Grid.Row="3" Margin="0,8,0,0" Background="#1E2226" BorderBrush="#3C444A" BorderThickness="1" Padding="7"><StackPanel><TextBlock x:Name="ProgrammerTitle" Text="PROGRAMMER - NO FIXTURES SELECTED" FontWeight="Bold" Margin="5"/><UniformGrid Columns="7"><Button Content="DIMMER" Tag="Dimmer" Click="FeatureGroup_Click"/><Button Content="POSITION" Tag="Position" Click="FeatureGroup_Click"/><Button Content="GOBO" Tag="Gobo" Click="FeatureGroup_Click"/><Button Content="COLOR" Tag="Color" Click="FeatureGroup_Click"/><Button Content="BEAM" Tag="Beam" Click="FeatureGroup_Click"/><Button Content="FOCUS" Tag="Focus" Click="FeatureGroup_Click"/><Button Content="CONTROL" Tag="Control" Click="FeatureGroup_Click"/></UniformGrid><Grid x:Name="DimmerControls"><UniformGrid Columns="4"><local:RotaryControl x:Name="DimmerSlider" Label="DIMMER" ValueChanged="DimmerSlider_ValueChanged"/><local:RotaryControl x:Name="EffectRateEncoder" Label="RATE Hz" Minimum="0.1" Maximum="10" Step="0.1" Value="1"/><local:RotaryControl x:Name="EffectLowEncoder" Label="EFFECT LOW"/><local:RotaryControl x:Name="EffectHighEncoder" Label="EFFECT HIGH" Value="255"/></UniformGrid></Grid><Grid x:Name="PositionControls" Visibility="Collapsed"><UniformGrid Columns="4"><local:RotaryControl x:Name="PanSlider" Label="PAN" Value="127" ValueChanged="PositionSlider_ValueChanged"/><local:RotaryControl x:Name="TiltSlider" Label="TILT" Value="127" ValueChanged="PositionSlider_ValueChanged"/><local:RotaryControl x:Name="EffectPhaseEncoder" Label="PHASE" Maximum="360" Step="5"/><Button Content="EDIT / RUN&#x0a;EFFECT" Click="ToggleEffect_Click" Background="#5C286D"/></UniformGrid></Grid><Grid x:Name="ColorControls" Visibility="Collapsed"><UniformGrid Columns="4"><local:RotaryControl x:Name="RedSlider" Label="RED" Value="255" ValueChanged="ColourSlider_ValueChanged"/><local:RotaryControl x:Name="GreenSlider" Label="GREEN" Value="255" ValueChanged="ColourSlider_ValueChanged"/><local:RotaryControl x:Name="BlueSlider" Label="BLUE" Value="255" ValueChanged="ColourSlider_ValueChanged"/><Button Content="STORE PRESET" Click="BeginStore_Click" Background="#176B87"/></UniformGrid></Grid><Grid x:Name="ControlControls" Visibility="Collapsed"><Grid><TextBlock Text="FIXTURE CONTROL CHANNELS&#x0a;Controls appear here when the selected fixture profile defines Control attributes." Foreground="#B8C1C7" TextAlignment="Center" VerticalAlignment="Center" Margin="10"/><Button x:Name="RunChaserButton" Visibility="Collapsed"/></Grid></Grid><TextBlock x:Name="UnsupportedFeatureText" Visibility="Collapsed" Text="Controls for this feature group will appear here as fixture attributes are implemented." Foreground="#B8C1C7" Margin="8,18" TextAlignment="Center"/></StackPanel></Border>
    </Grid>
<Border x:Name="ControlsDrawer" Grid.Column="2" Margin="0,0,8,0" Background="#1E2226" BorderBrush="#3C444A" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="CONTROLS" FontWeight="Bold" Margin="6"/><UniformGrid Columns="2"><Button Content="BACK" Click="Back_Click"/><Button Content="PAUSE" Click="Pause_Click"/><Button Content="GO" Click="Go_Click" Background="#23864C"/><Button Content="RELEASE" Click="Release_Click"/><Button x:Name="StoreButton" Content="STORE" Click="BeginStore_Click" Background="#8B312F"/><Button Content="RENAME" Click="RenameKeyword_Click"/><Button Content="UPDATE" Click="BeginUpdate_Click" Background="#7A621E"/><Button Content="DELETE" Click="Delete_Click"/><Button x:Name="ClearProgrammerButton" Content="CLEAR" Click="ClearProgrammer_Click" PreviewMouseLeftButtonDown="ClearButton_Down" PreviewMouseLeftButtonUp="ClearButton_Up"/><Button Content="STOMP" Click="StompButton_Click"/><Button Content="PRESET" Tag="PRESET" Click="CommandKeyword_Click"/><Button Content="GROUP" Tag="GROUP" Click="CommandKeyword_Click"/></UniformGrid><Button Content="NEW EFFECT" Click="CreateEffect_Click"/><Button Content="RELEASE EFFECTS" Click="ReleaseEffects_Click"/><local:RotaryControl x:Name="GrandMasterSlider" Height="126" Label="GRAND MASTER" Value="255" ValueChanged="GrandMasterSlider_ValueChanged"/></StackPanel></Border>
    <Border x:Name="PanTiltDrawer" Grid.Column="3" Background="#1E2226" BorderBrush="#3C444A" BorderThickness="1" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="PAN / TILT" FontWeight="Bold" Margin="6"/><Border x:Name="PositionPad" Grid.Row="1" Margin="8" Background="#121518" BorderBrush="#4B555C" BorderThickness="1" MouseLeftButtonDown="PositionPad_MouseLeftButtonDown"><Canvas><Ellipse x:Name="PositionMarker" Width="24" Height="24" Fill="#28A9D2" Stroke="White" StrokeThickness="2" Canvas.Left="135" Canvas.Top="135"/></Canvas></Border><Button Grid.Row="2" Content="PAN / TILT TEST" Click="PanTiltTest_Click"/></Grid></Border>
   </Grid>
   <Grid x:Name="CueWorkspace" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#1E2226" BorderBrush="#3C444A" BorderThickness="1" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" Text="CUE LISTS" FontWeight="Bold" FontSize="16" Margin="6"/><StackPanel DockPanel.Dock="Bottom"><Button Content="ADD CUE LIST" Click="AddCueList_Click"/><Button Content="TIMELINE" Click="OpenTimeline_Click"/></StackPanel><ListBox x:Name="CueListSelector" ItemsSource="{Binding CueLists}" DisplayMemberPath="DisplayName" SelectionChanged="CueListSelector_SelectionChanged" Background="#20252A" Foreground="White"/></DockPanel></Border><Border Grid.Column="1" Margin="10,0,0,0" Background="#1E2226" BorderBrush="#3C444A" BorderThickness="1" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBlock x:Name="CueListTitle" Text="CUE LIST 1 (TRACKING)" FontWeight="Bold" FontSize="16" Margin="6"/><Button Content="EDIT CUE" Click="EditCue_Click"/><Button Content="TYPE GO" Tag="Go" Click="CueType_Click"/><Button Content="TYPE FOLLOW" Tag="Follow" Click="CueType_Click"/><Button Content="TYPE WAIT" Tag="Wait" Click="CueType_Click"/></StackPanel><DataGrid x:Name="CueGrid" ItemsSource="{Binding Cues}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="CueGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Cue" Binding="{Binding Number}" Width="80"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/><DataGridTextColumn Header="Fade" Binding="{Binding Fade}" Width="90"/><DataGridTextColumn Header="Values" Binding="{Binding ValueCount}" Width="80"/><DataGridTextColumn Header="Follow" Binding="{Binding Follow}" Width="90"/></DataGrid.Columns></DataGrid></DockPanel></Border></Grid>
  </Grid>
  <Border x:Name="CommandOverlay" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20" Padding="24,14" Background="#E6101214" BorderBrush="#00D7D7" BorderThickness="2" CornerRadius="7" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="CommandOverlayText" Foreground="#FFCB36" FontFamily="Consolas" FontSize="26" FontWeight="Bold"/></Border>
<Border Grid.Row="2" Background="#101214" BorderBrush="#3C444A" BorderThickness="0,1"><Grid Margin="8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CommandModeText" Text="COMMAND [INSERT: ON]" Foreground="#00D7D7" FontWeight="Bold" VerticalAlignment="Center"/><TextBox x:Name="CommandLineText" Grid.Column="1" Background="#050606" Foreground="#FFCB36" BorderBrush="#00D7D7" FontFamily="Consolas" FontSize="17" Padding="8,3" KeyDown="CommandLineText_KeyDown"/><TextBlock x:Name="CommandHistoryText" Grid.Column="2" Foreground="#AAB2B7" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="StatusText" Grid.Column="3" Text="READY" Foreground="#FFB34D" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0"/></Grid></Border>
 </Grid>
</Window>










