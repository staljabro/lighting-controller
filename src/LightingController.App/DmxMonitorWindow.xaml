<Window x:Class="LightingController.App.DmxMonitorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DMX Allocation and Live Data" Width="1100" Height="760" Background="#15181B" Foreground="White" WindowStartupLocation="CenterOwner"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Universe" VerticalAlignment="Center" Margin="5"/><TextBox x:Name="UniverseText" Text="1" Width="70" Padding="8" Margin="5"/><Button Content="REFRESH" Click="Refresh_Click" Padding="15,8" Margin="5"/></StackPanel><DataGrid x:Name="ChannelGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="4"><DataGrid.Columns><DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="90"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="90"/><DataGridTextColumn Header="Fixture" Binding="{Binding Fixture}" Width="*"/><DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Window>
