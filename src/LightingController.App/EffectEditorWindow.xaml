<Window x:Class="LightingController.App.EffectEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Effect Editor" Width="1120" Height="650" Background="#15181B" Foreground="White" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="EFFECT LINE EDITOR" FontSize="22" FontWeight="Bold" Margin="5"/><UniformGrid Columns="4" Margin="4"><StackPanel Margin="4"><TextBlock Text="SCOPE"/><ComboBox x:Name="ScopeCombo" Padding="8"/></StackPanel><StackPanel Margin="4"><TextBlock Text="GROUPS"/><TextBox x:Name="GroupsText" Text="1" Padding="8"/></StackPanel><StackPanel Margin="4"><TextBlock Text="BLOCKS"/><TextBox x:Name="BlocksText" Text="1" Padding="8"/></StackPanel><StackPanel Margin="4"><TextBlock Text="WINGS"/><TextBox x:Name="WingsText" Text="1" Padding="8"/></StackPanel></UniformGrid><CheckBox x:Name="PhaseAcrossFixturePartsCheck" Content="Phase across fixture parts" Foreground="White" Margin="8,4" ToolTip="Spread phase across the parts of each selected fixture, in fixture selection order and then fixture profile order."/><StackPanel Orientation="Horizontal"><Button Content="ADD LINE" Click="AddLine_Click"/><Button Content="DELETE LINE" Click="DeleteLine_Click"/><TextBlock Text="Absolute lines output Low–High values. Relative lines add modulation to the current base value." Foreground="#B8C1C7" VerticalAlignment="Center" Margin="12"/></StackPanel></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox x:Name="RunningCheck" Content="Run immediately" Foreground="White" VerticalAlignment="Center" Margin="12"/><CheckBox x:Name="AutoApplyCheck" Content="Auto-apply" Foreground="White" VerticalAlignment="Center" Margin="12" ToolTip="Apply valid changes as you edit. Closing keeps changes already applied."/><Button x:Name="CancelButton" Content="CANCEL" IsCancel="True"/><Button Content="APPLY" Click="Apply_Click" Background="#176B87"/></StackPanel>
  <DataGrid x:Name="LineGrid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="48"><DataGrid.Columns><DataGridComboBoxColumn x:Name="AttributeColumn" Header="Attribute" SelectedItemBinding="{Binding Attribute, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Width="120"/><DataGridComboBoxColumn x:Name="FormColumn" Header="Waveform" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValueBinding="{Binding Form, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Width="110"/><DataGridComboBoxColumn x:Name="ModeColumn" Header="Mode" SelectedItemBinding="{Binding Mode, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Width="110"/><DataGridTextColumn Header="Low" Binding="{Binding Low, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Width="90"/><DataGridTextColumn Header="High" Binding="{Binding High, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Width="90"/><DataGridTextColumn Header="Speed Hz" Binding="{Binding SpeedHz, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Width="100"/><DataGridTextColumn Header="Phase From" Binding="{Binding PhaseFrom, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Width="110"/><DataGridTextColumn Header="Phase To" Binding="{Binding PhaseTo, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Width="100"/><DataGridTextColumn Header="Sine Offset (°)" Binding="{Binding SineOffsetDegrees, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Width="130"/><DataGridTextColumn Binding="{Binding Width, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Width="90"><DataGridTextColumn.Header><TextBlock Text="Width %" ToolTip="For Smooth Pulse and Square, the percentage of the cycle occupied by the pulse. The rest stays at Low."/></DataGridTextColumn.Header></DataGridTextColumn></DataGrid.Columns></DataGrid>
 </DockPanel>
</Window>
