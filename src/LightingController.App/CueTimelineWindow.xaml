<Window x:Class="LightingController.App.CueTimelineWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cue List Timeline" Width="1200" Height="600" Background="#15181B" Foreground="White" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="12"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBlock Text="TIMELINE" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="5,5,18,5"/><TextBlock Text="Drag blocks to reorder. Drag the right edge to resize fade time." Foreground="#B8C1C7" VerticalAlignment="Center"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><TextBlock x:Name="SelectedText" Text="No cue selected" VerticalAlignment="Center" Margin="6"/><TextBlock Text="Fade" VerticalAlignment="Center"/><TextBox x:Name="FadeText" Width="80" Margin="5" Padding="7"/><TextBlock Text="Follow" VerticalAlignment="Center"/><TextBox x:Name="FollowText" Width="80" Margin="5" Padding="7"/><Button Content="APPLY TIMING" Click="ApplyTiming_Click"/><Button Content="EDIT CUE" Click="EditCue_Click"/></StackPanel><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,10"><Canvas x:Name="TimelineCanvas" Height="410" Background="#101214"/></ScrollViewer></DockPanel>
</Window>
