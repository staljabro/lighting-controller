<Window x:Class="LightingController.App.FixtureDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Fixture Output Details" Width="720" Height="620" Background="#15181B" Foreground="White" WindowStartupLocation="CenterOwner"><DockPanel Margin="12"><TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="20" FontWeight="Bold" Margin="5,5,5,12"/><DataGrid x:Name="OutputGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="90"/><DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="*"/><DataGridTextColumn Header="Preset" Binding="{Binding Preset}" Width="190"/><DataGridTextColumn Header="Output" Binding="{Binding Value}" Width="90"/></DataGrid.Columns></DataGrid></DockPanel></Window>
