<Window x:Class="LightingController.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="900" Height="720" Background="#15181B" Foreground="White" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="14"><TextBlock DockPanel.Dock="Top" Text="SETTINGS" FontSize="22" FontWeight="Bold" Margin="4,4,4,12"/><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CANCEL" IsCancel="True"/><Button Content="SAVE" IsDefault="True" Click="Save_Click" Background="#176B87"/></StackPanel>
  <TabControl x:Name="SettingsTabs" Background="#1E2226" Foreground="White">
   <TabItem Header="HOTKEYS"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Top"><CheckBox x:Name="EnabledCheck" Content="Enable command hotkeys (Insert toggles during operation)" Foreground="White" Margin="6,8"/><Button Content="RESET DEFAULTS" HorizontalAlignment="Left" Click="Reset_Click"/></StackPanel><DataGrid x:Name="HotkeyGrid" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="100"/><DataGridTextColumn Header="Modifiers" Binding="{Binding Modifiers}" Width="130"/><DataGridTextColumn Header="Command text" Binding="{Binding Command}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
   <TabItem Header="OUTPUT PATCH"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="ADD ROUTE" Click="AddRoute_Click"/><Button Content="REMOVE ROUTE" Click="RemoveRoute_Click"/><TextBlock Text="USB DMX is intentionally disabled until an adapter is selected." Foreground="#FFB34D" VerticalAlignment="Center" Margin="12"/></StackPanel><DataGrid x:Name="RouteGrid" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="55"/><DataGridTextColumn Header="Universe" Binding="{Binding Universe}" Width="90"/><DataGridComboBoxColumn x:Name="TransportColumn" Header="Output" SelectedItemBinding="{Binding Transport}" Width="130"/><DataGridTextColumn Header="Destination / IP" Binding="{Binding Destination}" Width="*"/><DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="180"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
   <TabItem Header="MIDI"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal"><TextBlock Text="MIDI input" VerticalAlignment="Center" Margin="4"/><ComboBox x:Name="MidiDeviceCombo" Width="280" Margin="6" Padding="6"/><TextBlock Text="MIDI output / LCD" VerticalAlignment="Center" Margin="10,4,4,4"/><ComboBox x:Name="MidiOutputDeviceCombo" Width="280" Margin="6" Padding="6"/><Button Content="REFRESH" Click="RefreshMidi_Click"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="ADD MAPPING" Click="AddMidiBinding_Click"/><Button Content="REMOVE MAPPING" Click="RemoveMidiBinding_Click"/><Button x:Name="LearnButton" Content="MIDI LEARN" Click="LearnMidi_Click"/><TextBlock Text="Map commands, softkeys such as GO/STORE/CLEAR, named parameters such as PAN/RED, or dynamic ENCODER 1-4. MCU Relative supports V-Pots." Foreground="#B8C1C7" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12"/></StackPanel></StackPanel><DataGrid x:Name="MidiGrid" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/><DataGridTextColumn Header="Data 1" Binding="{Binding Data1}" Width="70"/><DataGridComboBoxColumn x:Name="MidiTargetTypeColumn" Header="Target type" SelectedItemBinding="{Binding TargetType}" Width="110"/><DataGridTextColumn Header="Target / command" Binding="{Binding Target}" Width="*"/><DataGridComboBoxColumn x:Name="MidiValueModeColumn" Header="Input mode" SelectedItemBinding="{Binding ValueMode}" Width="120"/><DataGridTextColumn Header="Min" Binding="{Binding OutputMinimum}" Width="65"/><DataGridTextColumn Header="Max" Binding="{Binding OutputMaximum}" Width="65"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
