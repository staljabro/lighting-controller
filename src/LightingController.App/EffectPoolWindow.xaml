<Window x:Class="LightingController.App.EffectPoolWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Effect Pool" Width="850" Height="580" Background="#15181B" Foreground="White" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="12"><TextBlock DockPanel.Dock="Top" Text="EFFECT POOL" FontSize="22" FontWeight="Bold" Margin="5,5,5,12"/><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="STORE CURRENT" Click="Store_Click" Background="#176B87"/><Button Content="EDIT" Click="Edit_Click"/><Button Content="APPLY / LAYER" Click="Apply_Click" Background="#23864C"/><Button Content="RELEASE" Click="Release_Click"/><Button Content="DELETE" Click="Delete_Click"/><Button Content="CLOSE" IsCancel="True"/></StackPanel><DataGrid x:Name="EffectGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionChanged="EffectGrid_SelectionChanged" MouseDoubleClick="EffectGrid_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="70"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="110"/><DataGridTextColumn Header="Wave" Binding="{Binding Definition.Waveform}" Width="100"/><DataGridTextColumn Header="Rate" Binding="{Binding Definition.RateHz}" Width="80"/><DataGridTextColumn Header="Fixtures / parts" Binding="{Binding SelectionDescription}" Width="220"/></DataGrid.Columns></DataGrid></DockPanel>
</Window>


