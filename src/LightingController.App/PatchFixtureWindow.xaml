<Window x:Class="LightingController.App.PatchFixtureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patch Fixture" Height="560" Width="560" ResizeMode="NoResize"
        Background="#1E2226" Foreground="White" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxStyle}"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="8"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="8"/></Style>
        <Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="16,9"/><Setter Property="Background" Value="#30363B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4B555C"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="FixtureTitle" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Fixture ID"/><TextBox x:Name="FixtureIdText" Text="1"/>
                    <TextBlock Text="Fixture name"/><TextBox x:Name="FixtureNameText"/>
                    <TextBlock Text="Universe"/><TextBox x:Name="UniverseText" Text="1"/>
                    <TextBlock Text="Quantity"/><TextBox x:Name="QuantityText" Text="1"/>
                    <TextBlock Text="Fixture ID offset"/><TextBox x:Name="IdOffsetText" Text="1"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Mode"/><ComboBox x:Name="ModeCombo" DisplayMemberPath="Name" SelectionChanged="ModeCombo_SelectionChanged"/>
                    <TextBlock Text="DMX address"/><TextBox x:Name="AddressText" Text="1"/>
                    <TextBlock Text="Footprint"/><TextBox x:Name="FootprintText" IsReadOnly="True"/>
                    <TextBlock Text="Address offset (0 = footprint)"/><TextBox x:Name="AddressOffsetText" Text="0"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ValidationText" Foreground="#FFB34D" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True"/><Button Content="Add fixture" Click="AddFixture_Click" Background="#176B87" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>

