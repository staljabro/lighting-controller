<Window x:Class="LightingController.App.CueEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Edit Cue" Width="520" Height="480" Background="#15181B" Foreground="White" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="16"><TextBlock DockPanel.Dock="Top" Text="EDIT CUE" FontSize="22" FontWeight="Bold" Margin="4,4,4,12"/><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CANCEL" IsCancel="True"/><Button Content="APPLY" Click="Apply_Click" Background="#176B87"/></StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Number" Margin="5"/><TextBox x:Name="NumberText" Grid.Column="1" Margin="5" Padding="8"/><TextBlock Grid.Row="1" Text="Name" Margin="5"/><TextBox x:Name="NameText" Grid.Row="1" Grid.Column="1" Margin="5" Padding="8"/><TextBlock Grid.Row="2" Text="Type" Margin="5"/><ComboBox x:Name="TypeCombo" Grid.Row="2" Grid.Column="1" Margin="5" Padding="8"/><TextBlock Grid.Row="3" Text="Fade seconds" Margin="5"/><TextBox x:Name="FadeText" Grid.Row="3" Grid.Column="1" Margin="5" Padding="8"/><TextBlock Grid.Row="4" Text="Follow seconds" Margin="5"/><TextBox x:Name="FollowText" Grid.Row="4" Grid.Column="1" Margin="5" Padding="8"/><TextBlock Grid.Row="5" Text="Notes" Margin="5"/><TextBox x:Name="NotesText" Grid.Row="5" Grid.Column="1" Margin="5" Padding="8" AcceptsReturn="True" TextWrapping="Wrap"/></Grid></DockPanel>
</Window>
